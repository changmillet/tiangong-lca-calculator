{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lca.study-analysis-config.v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "runIds"
      ],
      "properties": {
        "schemaVersion": {
          "const": "lca.study-analysis-config.v1"
        },
        "kind": {
          "const": "contribution"
        },
        "runIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "runIds"
      ],
      "properties": {
        "schemaVersion": {
          "const": "lca.study-analysis-config.v1"
        },
        "kind": {
          "const": "comparison"
        },
        "runIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    }
  ]
}
